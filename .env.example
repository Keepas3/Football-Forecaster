# Copy to .env and fill in your own keys. Never commit .env.

# https://www.football-data.org/client/register (free tier)
FOOTBALL_DATA_ORG_API_KEY=

# https://rapidapi.com/api-sports/api/api-football (free tier, optional)
API_FOOTBALL_KEY=

# https://console.anthropic.com/settings/keys -- powers the chat notes tab
ANTHROPIC_API_KEY=

# Optional override; defaults to claude-haiku-4-5-20251001 in config.py
SOCCER_PREDICTOR_CLAUDE_MODEL=

# Optional: point the database at a Turso (libSQL) instance instead of the
# local data/soccer.db file -- for a deployment with no persistent local
# disk (e.g. Streamlit Community Cloud). Leave both blank to keep using the
# local file, as today. TURSO_DATABASE_URL is just the host (e.g.
# "my-db-myorg.turso.io"), not a full URL. See https://turso.tech
# (free tier). NOTE: as of this writing, the sqlalchemy-libsql dependency
# this needs has no published wheel for Python 3.14 on any platform, so it
# isn't installed in this project yet -- add it yourself
# (uv add sqlalchemy-libsql) once you're on a Python version it supports.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: enables the hidden /admin dashboard page (refresh live data or
# retrain a model from inside the running app -- for a deployment with no
# way to run the CLI scripts, e.g. Streamlit Community Cloud). Leave blank
# to keep that page fully disabled.
ADMIN_PASSWORD=
